# Repo-wide ignores (each app also has its own .gitignore)

# Node
node_modules/
npm-debug.log*
.npm/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.jks
*.keystore
!debug.keystore

# Python (backend / notebooks)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Camera model: rivian_model/.gitignore keeps its weights (*.onnx, *.task, *.pt) and the warm-up frame out.
# Cabin-camera recordings are large and private (faces of real people): never commit them.
*.mp4
*.avi
*.mov
*.mkv

# Build outputs
dist/
build/
*.tsbuildinfo

# Generated native projects (Expo CNG)
frontend/mobile/android/
frontend/mobile/ios/

# Local-only reference copy of the Expo template demo
frontend/mobile/example/

# Claude Code personal files
.claude/settings.local.json
CLAUDE.local.md

# OS / editors
.DS_Store
Thumbs.db
.idea/
*.swp

# Claude Code agent worktrees (local checkouts of branches)
.claude/worktrees/
