{
  "version": "1.1",
  "description": "Koordinatorov RiskEngine (backend/app/coordinator/services/risk_engine.py): dokaz modela po kategoriji -> rizik, aktivne kategorije, pravila i alarm. Dokaze salje model (rivian_model/rivian_detector.py: phone_use, eyes_off_road, eyes_closed, collapse); kategorija koju model ne salje ima dokaz 0.",

  "smoothing": {
    "evidence_tau_s": 0.30,
    "risk_tau_s": 0.50
  },

  "groups": ["visual", "manual", "fatigue", "medical"],

  "categories": {
    "phone_use": {
      "weight": 0.95, "base": 0.25, "T_crit_s": 1.5, "k": 2.5, "decay": 1.0,
      "on": 0.55, "off": 0.35,
      "membership": {"visual": 1.0, "manual": 0.7}
    },
    "eyes_off_road": {
      "weight": 0.85, "base": 0.05, "T_crit_s": 2.0, "k": 2.5, "decay": 2.0,
      "on": 0.55, "off": 0.35,
      "membership": {"visual": 1.0}
    },
    "hands_off_wheel": {
      "weight": 0.60, "base": 0.20, "T_crit_s": 3.0, "k": 1.2, "decay": 1.5,
      "on": 0.50, "off": 0.30,
      "membership": {"manual": 1.0}
    },
    "eating_drinking": {
      "weight": 0.45, "base": 0.20, "T_crit_s": 4.0, "k": 1.0, "decay": 1.0,
      "on": 0.50, "off": 0.30,
      "membership": {"manual": 0.8, "visual": 0.3}
    },
    "drowsiness": {
      "weight": 0.65, "base": 0.40, "T_crit_s": 10.0, "k": 0.4, "decay": 0.5,
      "on": 0.45, "off": 0.30,
      "membership": {"fatigue": 1.0}
    },
    "eyes_closed": {
      "weight": 1.00, "base": 0.00, "T_crit_s": 0.9, "k": 7.0, "decay": 6.0,
      "on": 0.60, "off": 0.40,
      "membership": {"fatigue": 1.0}
    },
    "collapse": {
      "weight": 1.00, "base": 0.50, "T_crit_s": 2.0, "k": 3.0, "decay": 6.0,
      "on": 0.50, "off": 0.25,
      "membership": {"medical": 1.0}
    }
  },

  "rules": [
    {"name": "microsleep",       "type": "duration",  "category": "eyes_closed",   "min_s": 1.5, "floor": 0.75},
    {"name": "long_distraction", "type": "duration",  "category": "eyes_off_road", "min_s": 3.0, "floor": 0.50},
    {"name": "phone_sustained",  "type": "duration",  "category": "phone_use",     "min_s": 2.0, "floor": 0.50},
    {"name": "collapse",         "type": "duration",  "category": "collapse",      "min_s": 2.0, "floor": 1.00},
    {"name": "vats",             "type": "vats", "window_s": 30.0, "cum_s": 10.0, "reset_on_road_s": 2.0, "floor": 0.50}
  ],

  "context": {
    "use_speed": false,
    "speed_min_kmh": 10.0,
    "stationary_factor": 0.2
  },

  "alerts": {
    "yellow": {"on": 0.40, "off": 0.30},
    "red":    {"on": 0.70, "off": 0.55},
    "rise_hold_s": 0.3,
    "fall_hold_s": 1.0,
    "min_display_s": 2.0
  }
}
