# Settings of the Docker stack. start.ps1 writes docker/.env from its parameters; edit it by hand only for plain
# `docker compose` runs. Every value has a default in the compose files.

# Laptop's LAN IP, for the phone QR on the dashboard (start.ps1 finds it; it changes with every hotspot)
HOST_IP=
# Folder with the dataset clips (*_video_inCabin.mp4), mounted read-only into the camera
DATASET_DIR=
# Camera: per-trip (each trip = next clip of CLIPS), loop (VIDEO on a loop), test (test pattern), off
CAMERA_MODE=per-trip
CLIPS=05_23_62_031246 05_23_62_021254 05_23_62_005853
VIDEO=
# Driver zone of the model: 05_23 or 08_14, the same series as the clips
MODEL_CAMERA=05_23
# Mocked speed: city, highway, stop_and_go, country_road, cruise, parked, random
SPEED_SCENARIO=cruise
# Host ports
COORDINATOR_PORT=8000
SERVER_PORT=8001
DASHBOARD_PORT=5173
# Only when a part runs alone (docker compose -f docker/<part>.yml): where the others are
# SERVER_URL=http://host.docker.internal:8001/api/v1
# COORDINATOR_UPSTREAM=host.docker.internal:8000
# SERVER_UPSTREAM=host.docker.internal:8001
