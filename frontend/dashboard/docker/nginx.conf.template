# The dashboard + its API, one origin (nginx image: ${VAR}s are filled from the environment at start).
# Routes follow docs/API.md §5: [S] stored trips, accounts, images go to the server, everything else ([K]: live socket,
# start/end, telemetry, status) to the coordinator. Upstreams are resolved per request (Docker DNS), so nginx starts
# even while they don't run yet and follows them when they restart.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $coordinator http://${COORDINATOR_UPSTREAM};
    set $server http://${SERVER_UPSTREAM};

    proxy_http_version 1.1;
    # The server builds absolute image URLs from Host, so they point back at this origin.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
    client_max_body_size 20m;

    # [S] accounts, images, company analytics
    location ~ ^/api/v1/(auth|media|analytics)(/|$) {
        proxy_pass $server;
    }
    # [S] a stored trip's summary, report, sections
    location ~ ^/api/v1/trips/[^/]+/(summary|report|sections)$ {
        proxy_pass $server;
    }
    # GET /trips = history [S]; POST /trips = start a trip [K]
    location = /api/v1/trips {
        if ($request_method = GET) {
            proxy_pass $server;
        }
        proxy_pass $coordinator;
    }
    # [K] everything else: WS /ws, /trips/{id}, /trips/{id}/end, /telemetry, /speed, /coordinator/status, /health
    location /api/ {
        proxy_pass $coordinator;
    }

    location = /runtime-config.js {
        add_header Cache-Control "no-store";
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    # client-side routes (/trip/:id): the app
    location / {
        try_files $uri /index.html;
    }
}
