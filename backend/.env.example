# Copy to backend/.env and change what you need. Every value here is already the default.
# The two parts and what each one does: docs/ARCHITECTURE.md

APP_NAME="Personal Safety Reviewer API"
API_PREFIX=/api/v1
# JSON list of allowed origins (Expo web / dashboard). Native apps don't need CORS.
CORS_ORIGINS=["*"]

# --- Coordinator (in the car) ---
# Where the coordinator delivers its section summaries. Empty = the server part runs in this same process.
# Split deployment (python run.py --role coordinator): the server's API base, e.g. http://127.0.0.1:8001/api/v1
SERVER_URL=
# Shared secret on /internal/* (coordinator -> server). Change it when the server is reachable by others.
INTERNAL_TOKEN=dev-internal-token
# Seconds of driving per section summary (chart point, WS `section`, database row).
SECTION_S=2.0
# Model detections arrive 5-10/s; the phone gets a `state` this often (and at once on every change).
LIVE_STATE_INTERVAL_S=0.5
# The CV team's thresholds for the risk engine. Empty = ../notebooks/risk_config.json
RISK_CONFIG_PATH=
# Video kept to pull the image of a dangerous moment: disk (diskcache, temp folder wiped on start) or memory.
VIDEO_CACHE=disk
VIDEO_CACHE_DIR=
VIDEO_CACHE_S=300
VIDEO_CACHE_FPS=10
VIDEO_CACHE_MAX_MB=1024
SECTION_IMAGE_WIDTH=960

# --- Server: accounts, trips, sections (Postgres) + images (S3). If they are down, the live score still works. ---
RECORDING_ENABLED=true
DATABASE_URL=postgresql+asyncpg://safety:safety@127.0.0.1:5433/safety
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=safety
S3_SECRET_KEY=safety-secret
S3_BUCKET=safety-media
S3_REGION=us-east-1
# Demo only: anyone can read the bucket. Production access is still to be designed.
S3_PUBLIC_READ=true

# --- Speed (coordinator; the camera doesn't know it, a real car would read the CAN bus) ---
# random | city | highway | stop_and_go | country_road | cruise | parked   (cruise never stops: good for a stage demo)
SPEED_SCENARIO=random
# The phone's GPS through POST /speed. When on, a fresh reading beats the mock.
PHONE_SPEED_ENABLED=false
